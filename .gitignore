# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/
/apps/web/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# secrets and local backups
/secrets/*
!/secrets/.gitkeep
/backups/

# local attachment bytes (ADR 0009)
/data/
/apps/web/data/

# agent tooling (Prisma skills, editor agents)
.agents/
.claude/
.cursor/
.devin/
skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma local sqlite (not used, but ignore if present)
*.db
*.db-journal

# editor
.idea/
.vscode/
