# Cashow — canonical environment (copy to `.env` and fill in real values).
# See packages/config/src/env.ts for the Zod schema these are validated against.
#
# Any value may instead be supplied as `<NAME>_FILE=/run/secrets/<name>` when
# running under Docker secrets; the file contents are read at boot.

# --- Runtime -------------------------------------------------------------
NODE_ENV="development"

# --- Database (PostgreSQL >= 15) -----------------------------------------
# Local development (Compose publishes nothing; run Postgres yourself or use
# the `postgres` service from docker-compose.yml on an internal network).
DATABASE_URL="postgresql://default:default@localhost:5432/cashow"

# Docker Compose credentials. The compose file builds DATABASE_URL from these
# and the service name, overriding the value above.
POSTGRES_USER="cashow"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="cashow"

# --- Web ----------------------------------------------------------------
WEB_ORIGIN="http://localhost:3000"

# Permanent name used by Caddy. Change it before creating passkeys: WebAuthn
# credentials are bound to the domain.
CASHOW_DOMAIN="localhost"
WEB_PORT="3000"
# CASHOW_WEB_IMAGE="ghcr.io/you/cashow:0.1.0-web"
# CASHOW_WORKER_IMAGE="ghcr.io/you/cashow:0.1.0-worker"

# --- Auth ----------------------------------------------------------------
# Passkey sessions use random tokens hashed at rest, so no signing secret is
# required. Keep AUTH_SECRET for future signed tokens.
# AUTH_SECRET=""
#
# Optional one-time token for the first-run /setup page. Set it when the app is
# reachable before you finish setup. Remove it after the owner exists.
# SETUP_TOKEN=""
#
# WebAuthn relying party. Defaults to the WEB_ORIGIN hostname. Passkeys are
# bound to it, so set the permanent domain before creating any passkey.
# WEBAUTHN_RP_ID=""
WEBAUTHN_RP_NAME="Cashow"

# --- Framework compatibility gates ---------------------------------------
# Opt-in token for `/compat` and `/api/compat/stream` (Server Action, streaming,
# abort). Leave empty in normal operation: unset means both routes answer 404.
# Use it only in CI or on a disposable deployment:
#   COMPAT_TOKEN="…" bun run smoke:compat
# COMPAT_TOKEN=""

# --- AI (DeepSeek) — leave empty to disable AI features -------------------
# DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_PRO_MODEL="deepseek-v4-pro"

# --- Web Push (VAPID) — optional ------------------------------------------
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT=""

# --- Notification channels — optional, off by default ---------------------
# NTFY_TOPIC=""
# TELEGRAM_BOT_TOKEN=""
# SMTP_URL=""

# --- Logging -------------------------------------------------------------
LOG_LEVEL="info"

# --- Storage (attachments) ----------------------------------------------
# Local directory for receipt/invoice bytes (ADR 0009). Compose overrides this
# to /app/data/uploads on the shared `files` volume.
# STORAGE_DIR="./data/uploads"

# --- Backups (profile: backup) -------------------------------------------
# age public key; the private key stays offline and lives at
# secrets/age.key (mounted read-only only for restores).
# BACKUP_AGE_RECIPIENT="age1..."
# BACKUP_RCLONE_REMOTE="b2:cashow-backups"
BACKUP_RETENTION_DAYS="30"
# Host path mounted at /external inside the backup container. For the external
# drive: BACKUP_EXTERNAL_DIR="/Volumes/CashowBackup" (macOS) and
# BACKUP_RCLONE_REMOTE="local:/external/cashow" (or a configured rclone remote).
# BACKUP_EXTERNAL_DIR="./backups"
# BACKUP_AGE_KEY="/secrets/age.key"
# RCLONE_CONFIG="/secrets/rclone.conf"
