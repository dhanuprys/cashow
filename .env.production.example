# =============================================================================
# Cashow — Production Environment Configuration
# =============================================================================
# Copy this file to `.env` on your production server:
#   cp .env.production.example .env
#
# IMPORTANT: Generate secure random keys before starting:
#   POSTGRES_PASSWORD : openssl rand -base64 24
#   AUTH_SECRET       : openssl rand -hex 32
#   SETUP_TOKEN       : openssl rand -hex 16
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV="production"
TZ="Asia/Jakarta"
LOG_LEVEL="info"

# --- Database (PostgreSQL 18) ------------------------------------------------
# Used by docker-compose to initialize Postgres and construct the internal DATABASE_URL.
POSTGRES_USER="cashow"
POSTGRES_PASSWORD="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24"
POSTGRES_DB="cashow"

# --- Web & Reverse Proxy -----------------------------------------------------
# The port bound on the host machine. Your external reverse proxy (Nginx, Traefik,
# Cloudflare Tunnel, etc.) should forward traffic to http://127.0.0.1:3000
WEB_PORT="3000"

# Canonical public URL where users access the app (MUST use https in production).
# WebAuthn passkeys and CSRF origin validation strictly verify this URL.
# Supports comma-separated values if accessed via multiple domains.
WEB_ORIGIN="https://cashow.example.com"

# The Relying Party ID for WebAuthn passkeys (domain name without protocol or port).
# Leave empty to automatically derive from WEB_ORIGIN.
WEBAUTHN_RP_ID=""
WEBAUTHN_RP_NAME="Cashow"

# --- Container Images --------------------------------------------------------
# Pull pre-built multi-arch images directly from GitHub Container Registry (GHCR).
CASHOW_WEB_IMAGE="ghcr.io/dhanuprys/cashow:latest"
CASHOW_WORKER_IMAGE="ghcr.io/dhanuprys/cashow:worker"

# --- Authentication & Security -----------------------------------------------
# Session secret used for signing tokens and session cookies.
# Generate: openssl rand -hex 32
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"

# Secret used to sign AI write-action approvals in chat.
# If unset, automatically falls back to AUTH_SECRET.
TOOL_APPROVAL_SECRET=""

# One-time protection token for the initial `/setup` registration screen.
# Prevents strangers from registering as the owner if your instance is publicly reachable.
# Remove or clear this variable after you finish account setup.
# Generate: openssl rand -hex 16
SETUP_TOKEN="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_16"

# Enable username/password authentication alongside Passkeys ("true" or "false").
WEB_PASSWORD_AUTH="true"

# --- AI Assistant (Optional) -------------------------------------------------
# Default credentials for the AI chat assistant (/app/chat).
# Users can also configure their own API keys via the Settings UI.
#
# DeepSeek:
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_PRO_MODEL="deepseek-reasoner"
#
# Google Gemini:
GOOGLE_GENERATIVE_AI_API_KEY=""
GOOGLE_MODEL="gemini-2.5-flash"

# --- Google OAuth (Optional) -------------------------------------------------
# Enable "Masuk dengan Google" in login and account linking in Settings.
# Authorized redirect URI in Google Cloud Console:
#   https://cashow.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Web Push Notifications (Optional) ---------------------------------------
# Generate VAPID keypair:
#   bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- Notification Channels (Optional) ----------------------------------------
TELEGRAM_BOT_TOKEN=""
SMTP_URL=""

# --- Storage & Uploads -------------------------------------------------------
# Files volume stores receipt/invoice attachments securely.
STORAGE_DRIVER="local"
STORAGE_DIR="/app/data/uploads"

# --- Automated Encrypted Backups (Optional) ----------------------------------
# To enable nightly automated encrypted backups at 02:15 UTC:
#   1. Generate an age keypair: age-keygen -o secrets/age.key
#   2. Fill in BACKUP_AGE_RECIPIENT with the public key (starts with age1...)
#   3. Run: docker compose --profile backup up -d
BACKUP_DIR="./backups"
BACKUP_AGE_RECIPIENT=""
BACKUP_RETENTION_DAYS="30"
