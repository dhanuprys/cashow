// use prisma-8

// Cashow — data contract (Phase 0 core ledger)
//
// The five data-integrity rules from the plan (§2):
//   1. Integer money  — whole rupiah as 64-bit integers (`BigInt`).
//   2. Two clocks     — `occurredAt` (editable, drives reports) and
//                       `createdAt` (system-set, never editable), both
//                       zone-aware (`TimestamptzString`).
//   3. Stored date    — `occurredOn` is the calendar date in the user's
//                       timezone, derived at write time (`DateString`).
//   4. Derive, don't store — balances/statuses are computed, never typed in.
//   5. DB-enforced invariants — positive amounts, transfer accounts differ,
//                       allocation uniqueness, one snapshot per account+instant.

// ---------------------------------------------------------------------------
// Enums (stored as text, enforced by a planner-generated CHECK constraint)
// ---------------------------------------------------------------------------

enum TransactionType {
  @@type("pg/text@1")
  INCOME      = "INCOME"
  EXPENSE     = "EXPENSE"
  TRANSFER    = "TRANSFER"
  ADJUSTMENT  = "ADJUSTMENT"
}

enum AccountType {
  @@type("pg/text@1")
  BANK       = "BANK"
  EWALLET    = "EWALLET"
  CASH       = "CASH"
  INVESTMENT = "INVESTMENT"
}

enum CategoryKind {
  @@type("pg/text@1")
  INCOME  = "INCOME"
  EXPENSE = "EXPENSE"
}

enum Source {
  @@type("pg/text@1")
  MANUAL           = "MANUAL"
  QUICK_ADD        = "QUICK_ADD"
  AI_DRAFT         = "AI_DRAFT"
  TELEGRAM         = "TELEGRAM"
  STATEMENT_IMPORT = "STATEMENT_IMPORT"
  RECURRING        = "RECURRING"
  SHARE_TARGET     = "SHARE_TARGET"
}

enum OutboxStatus {
  @@type("pg/text@1")
  PENDING    = "PENDING"
  // Claimed by a worker under `FOR UPDATE SKIP LOCKED`.
  PROCESSING = "PROCESSING"
  PROCESSED  = "PROCESSED"
  FAILED     = "FAILED"
}

enum AuthChallengePurpose {
  @@type("pg/text@1")
  REGISTRATION   = "REGISTRATION"
  AUTHENTICATION = "AUTHENTICATION"
}

enum AttachmentKind {
  @@type("pg/text@1")
  PROOF    = "PROOF"
  INVOICE  = "INVOICE"
  CONTRACT = "CONTRACT"
  RECEIPT  = "RECEIPT"
}

enum RecurringFrequency {
  @@type("pg/text@1")
  DAILY   = "DAILY"
  WEEKLY  = "WEEKLY"
  MONTHLY = "MONTHLY"
  YEARLY  = "YEARLY"
}

enum AiProviderType {
  @@type("pg/text@1")
  GOOGLE            = "GOOGLE"
  DEEPSEEK          = "DEEPSEEK"
  OPENAI            = "OPENAI"
  OPENAI_COMPATIBLE = "OPENAI_COMPATIBLE"
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id                  String  @id @onCreate(uuid(7))
  username            String? @unique
  email               String? @unique
  name                String?
  avatar              String? // Avatar preset id or SVG identifier
  bio                 String? // Optional user bio / personal note
  password            String? // bcrypt hash; null when login is passkey-only
  // Timezone used to derive `occurredOn` and group reports. WIB is the
  // default; the plan requires WIB/WITA/WIT correctness in tests.
  timezone            String  @default("Asia/Jakarta")
  // 0 = Sunday … 6 = Saturday. 1 = Monday.
  weekStartsOn        Int     @default(1)
  // Budget month starts on this day of the month (e.g. 25 = payday).
  budgetMonthStartDay Int     @default(1)
  currency            String  @default("IDR")
  createdAt           TimestamptzString @onCreate(now())
  updatedAt           TimestamptzString @onCreate(now()) @onUpdate(now())

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  attachments  Attachment[]
  passkeys     Passkey[]
  sessions     Session[]
  paymentPlans        PaymentPlan[]
  snapshots           BalanceSnapshot[]
  checkpoints         ReconciliationCheckpoint[]
  budgets             Budget[]
  recurringTemplates   RecurringTemplate[]
  recurringDrafts      RecurringDraft[]
  channelEndpoints    ChannelEndpoint[]
  notifications       Notification[]
  rules               Rule[]
  ruleStates          RuleState[]
  ruleFirings         RuleFiring[]
  chatThreads         ChatThread[]
  chatMessages        ChatMessage[]
  aiFacts             AiFact[]
  aiProviderConfigs   AiProviderConfig[]
}

// ---------------------------------------------------------------------------
// Auth: passkeys, sessions, and short-lived WebAuthn challenges
// ---------------------------------------------------------------------------
//
// Passkeys are the only sign-in method. There is no password column and no
// public sign-up: the first user is created by the one-time `/setup` flow, and
// the schema stays multi-user ready.

model Passkey {
  id           String  @id @onCreate(uuid(7))
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Credential ID from the authenticator, base64url (unique per credential).
  credentialId String  @unique
  // COSE public key, base64url. Kept as text so the contract needs no byte
  // scalar; it is decoded only when verifying an assertion.
  publicKey    String
  // Signature counter; `BigInt` because authenticators report an unsigned
  // 32-bit value that can exceed the 32-bit signed range.
  counter      BigInt  @default(0)
  // Comma-separated WebAuthn transports (`internal`, `hybrid`, …).
  transports   String?
  // "SingleDevice" or "MultiDevice" (informational, for the passkey list).
  deviceType   String?
  backedUp     Boolean @default(false)
  // User-visible label, e.g. "iPhone", set at registration.
  name         String?
  createdAt    TimestamptzString @onCreate(now())
  lastUsedAt   TimestamptzString?
  // Revoked credentials are kept for the audit trail, never accepted again.
  revokedAt    TimestamptzString?

  @@index([userId])
}

model Session {
  id         String  @id @onCreate(uuid(7))
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the random cookie token; the token itself is never stored.
  tokenHash  String  @unique
  expiresAt  TimestamptzString
  createdAt  TimestamptzString @onCreate(now())
  lastUsedAt TimestamptzString @onCreate(now())
  ipAddress  String?
  userAgent  String?
  revokedAt  TimestamptzString?

  @@index([userId])
  @@index([expiresAt])
}

model AuthChallenge {
  id        String               @id @onCreate(uuid(7))
  purpose   AuthChallengePurpose
  // The base64url challenge signed by the authenticator.
  challenge String               @unique
  // The account this ceremony belongs to: an existing user for sign-in or
  // "add passkey", or the id the first owner will receive at registration.
  // Deliberately not an FK — a pending registration has no User row yet.
  subjectId String?
  // Registration only: { email?, name? } to write when verification succeeds.
  payload   Json?
  expiresAt TimestamptzString
  // Single-use. Set atomically with the condition `consumedAt IS NULL`.
  consumedAt TimestamptzString?
  createdAt  TimestamptzString @onCreate(now())

  @@index([expiresAt])
}

model Account {
  id             String      @id @onCreate(uuid(7))
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType
  // Opening balance as whole rupiah (may be negative for a debt account).
  openingBalance BigInt      @default(0)
  currency       String      @default("IDR")
  archivedAt     TimestamptzString?
  createdAt      TimestamptzString @onCreate(now())
  updatedAt      TimestamptzString @onCreate(now()) @onUpdate(now())

  transactions         Transaction[] @relation("TxAccount")
  snapshots            BalanceSnapshot[]
  checkpoints          ReconciliationCheckpoint[]
  recurringAsSource    RecurringTemplate[] @relation("RecurringSource")
  recurringAsDestination RecurringTemplate[] @relation("RecurringDestination")
  recurringDraftsAsSource RecurringDraft[] @relation("RecurringDraftSource")
  recurringDraftsAsDestination RecurringDraft[] @relation("RecurringDraftDestination")

  @@index([userId])
  @@index([userId, type])
}

model Category {
  id         String       @id @onCreate(uuid(7))
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       CategoryKind
  parentId   String?
  parent     Category?    @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  icon       String?
  color      String?
  archivedAt TimestamptzString?
  createdAt  TimestamptzString @onCreate(now())
  updatedAt  TimestamptzString @onCreate(now()) @onUpdate(now())

  transactions      Transaction[]
  budgets           Budget[]
  recurringTemplates RecurringTemplate[]
  recurringDrafts   RecurringDraft[]

  @@unique([userId, kind, name])
  @@index([userId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Payment plans: chained project income
// ---------------------------------------------------------------------------
//
// A project paid as DP, termin 2 and final is one plan with three items. Each
// real payment is an ordinary INCOME linked to an item. Status, totals and
// outstanding amounts are derived from live linked incomes, never stored
// (plan §2, "Derive, do not store").

model PaymentPlan {
  id          String  @id @onCreate(uuid(7))
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Plans are archived, never deleted, once they hold payment history.
  archivedAt  TimestamptzString?
  createdAt   TimestamptzString @onCreate(now())
  updatedAt   TimestamptzString @onCreate(now()) @onUpdate(now())

  items       PaymentPlanItem[]
  attachments Attachment[]

  @@index([userId])
  @@index([userId, archivedAt])
}

model PaymentPlanItem {
  id             String      @id @onCreate(uuid(7))
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label          String
  // Expected whole rupiah; several incomes may pay this one item.
  expectedAmount BigInt
  // Optional local due date (`YYYY-MM-DD`), used only to derive OVERDUE.
  dueOn          DateString?
  note           String?
  sortOrder      Int         @default(0)
  createdAt      TimestamptzString @onCreate(now())
  updatedAt      TimestamptzString @onCreate(now()) @onUpdate(now())

  incomes     Transaction[]  @relation("TxPlanItem")
  attachments Attachment[]

  @@index([userId, planId])
  @@index([planId, sortOrder])
  // Rule 5 — an item asks for a positive amount.
  @@check(expression: sql`"expectedAmount" > 0`, name: "expected_amount_positive")
}

model Transaction {
  id                   String        @id @onCreate(uuid(7))
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 TransactionType
  // Positive whole rupiah; the type gives the sign (rule 1).
  amount               BigInt
  accountId            String
  account              Account       @relation("TxAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccountId String?
  destinationAccount   Account?      @relation("TxDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  categoryId           String?
  category             Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Chained payment: an INCOME that settles a payment-plan item.
  planItemId           String?
  planItem             PaymentPlanItem? @relation("TxPlanItem", fields: [planItemId], references: [id], onDelete: Restrict)
  // A transfer fee is an ordinary EXPENSE linked to the transfer it paid for.
  transferId           String?       @unique
  transfer             Transaction?  @relation("TransferFee", fields: [transferId], references: [id], onDelete: Restrict)
  feeFor               Transaction?  @relation("TransferFee")
  merchant             String?
  counterparty         String?
  note                 String?
  // Editable instant that drives every report (rule 2).
  occurredAt           TimestamptzString
  // Calendar date in the user's timezone at write time (rule 3).
  occurredOn           DateString
  source               Source        @default(MANUAL)
  // Client request id for idempotent creates.
  clientRequestId      String?
  createdAt            TimestamptzString @onCreate(now())
  updatedAt            TimestamptzString @onCreate(now()) @onUpdate(now())
  // Soft delete: void allocations on delete, restore them on un-delete.
  deletedAt            TimestamptzString?

  allocationsOut Allocation[] @relation("AllocExpense")
  allocationsIn  Allocation[] @relation("AllocIncome")
  attachments    Attachment[]

  // One unique outstanding client request per user (idempotency).
  @@unique([userId, clientRequestId])
  @@index([userId, occurredOn])
  @@index([userId, occurredAt])
  // The transaction list only reads live rows; a partial index keeps the
  // dashboard's "recent" query from touching soft-deleted history.
  @@index([userId, occurredAt], where: sql`"deletedAt" IS NULL`, name: "Transaction_live_recent_idx")
  @@index([accountId])
  @@index([categoryId])
  @@index([destinationAccountId])
  @@index([planItemId])
  // Rule 5 — positive amounts.
  @@check(expression: sql`"amount" > 0`, name: "amount_positive")
  // Rule 5 — a transfer has exactly one destination, and it differs.
  @@check(expression: sql`("type" = 'TRANSFER') = ("destinationAccountId" IS NOT NULL)`, name: "transfer_destination_consistency")
  @@check(expression: sql`"type" <> 'TRANSFER' OR "destinationAccountId" <> "accountId"`, name: "transfer_accounts_differ")
  // Only cashflow rows carry a category; a transfer is not spending.
  @@check(expression: sql`"type" IN ('INCOME', 'EXPENSE') OR "categoryId" IS NULL`, name: "category_only_for_cashflow")
  // Only an income can settle a payment-plan item.
  @@check(expression: sql`"planItemId" IS NULL OR "type" = 'INCOME'`, name: "plan_item_only_for_income")
  // Only an expense can be the fee of a transfer.
  @@check(expression: sql`"transferId" IS NULL OR "type" = 'EXPENSE'`, name: "transfer_fee_only_for_expense")
}

model Allocation {
  id        String      @id @onCreate(uuid(7))
  userId    String
  // The expense drawing the money.
  expenseId String
  expense   Transaction @relation("AllocExpense", fields: [expenseId], references: [id], onDelete: Cascade)
  // The income being drawn from.
  incomeId  String
  income    Transaction @relation("AllocIncome", fields: [incomeId], references: [id], onDelete: Cascade)
  // Positive whole rupiah.
  amount    BigInt
  createdAt TimestamptzString @onCreate(now())

  // One allocation per expense-income pair.
  @@unique([expenseId, incomeId])
  @@index([incomeId])
  @@index([userId])
  // Rule 5 — positive amounts; the sum-vs-source invariant is enforced by a
  // trigger in the migration (a CHECK cannot read other rows).
  @@check(expression: sql`"amount" > 0`, name: "amount_positive")
  // An allocation must not point at the same transaction on both sides.
  @@check(expression: sql`"expenseId" <> "incomeId"`, name: "distinct_transactions")
}

model Attachment {
  id            String         @id @onCreate(uuid(7))
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Evidence belongs to exactly one target: a transaction, a plan or an item.
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  planId        String?
  plan          PaymentPlan?   @relation(fields: [planId], references: [id], onDelete: Cascade)
  planItemId    String?
  planItem      PaymentPlanItem? @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  kind          AttachmentKind @default(PROOF)
  // Content-addressed path inside the storage driver, e.g. "<userId>/<sha256>.webp".
  storageKey    String
  fileName      String
  mimeType      String
  byteSize      BigInt
  // SHA-256 of the stored bytes, to catch duplicate uploads.
  contentHash   String
  createdAt     TimestamptzString @onCreate(now())
  // Soft delete keeps the audit trail; the bytes are removed when unreferenced.
  deletedAt     TimestamptzString?

  @@index([userId, transactionId])
  @@index([userId, planId])
  @@index([userId, planItemId])
  @@index([userId, contentHash])
  @@index([storageKey])
  // Rule 5 — a stored file has a positive size.
  @@check(expression: sql`"byteSize" > 0`, name: "byte_size_positive")
  // Exactly one target, so an attachment cannot silently belong to two things.
  @@check(expression: sql`num_nonnulls("transactionId", "planId", "planItemId") = 1`, name: "attachment_one_target")
}

model BalanceSnapshot {
  id         String      @id @onCreate(uuid(7))
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Manual balance at a chosen instant (may be negative).
  amount     BigInt
  // The instant this balance is "as of". Append-only; corrections are new
  // snapshots or soft-deleted ones with an audit entry.
  recordedAt TimestamptzString
  note       String?
  createdAt  TimestamptzString @onCreate(now())
  deletedAt  TimestamptzString?

  checkpoints ReconciliationCheckpoint[]

  // Rule 5 — one live snapshot per account and instant. Soft-deleted rows are
  // excluded so a correction can reuse the same instant with an audit trail.
  @@index([accountId, recordedAt], unique: true, where: sql`"deletedAt" IS NULL`, name: "BalanceSnapshot_live_unique")
  @@index([userId, accountId, recordedAt])
}

model ReconciliationCheckpoint {
  id           String      @id @onCreate(uuid(7))
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // The zero-gap snapshot being marked as verified.
  snapshotId   String
  snapshot     BalanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  // The snapshot instant. Transactions at or before this instant are frozen
  // while the checkpoint is active.
  snapshotAt   TimestamptzString
  // When the owner marked the snapshot verified.
  verifiedAt   TimestamptzString @onCreate(now())
  // Deliberate, audited unlock.
  unlockedAt   TimestamptzString?
  unlockReason String?
  createdAt    TimestamptzString @onCreate(now())

  // One active checkpoint per account and snapshot instant; an unlocked row
  // stays as history and does not block a later re-verification.
  @@index([accountId, snapshotAt], unique: true, where: sql`"unlockedAt" IS NULL`, name: "Checkpoint_active_unique")
  @@index([userId, accountId])
  @@index([snapshotId])
}

// ---------------------------------------------------------------------------
// Budgets and recurring templates (Phase 3)
// ---------------------------------------------------------------------------
//
// A budget is a spending limit for one category (or the whole ledger) over a
// budget month. Usage and projection are derived on read from live transactions.
// Recurring templates create draft transactions on a schedule; the owner
// confirms or skips each one.

model Budget {
  id         String    @id @onCreate(uuid(7))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // Null means the budget covers every expense category.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Limit in whole rupiah for one budget month.
  amount     BigInt
  active     Boolean   @default(true)
  createdAt  TimestamptzString @onCreate(now())
  updatedAt  TimestamptzString @onCreate(now()) @onUpdate(now())

  @@index([userId])
  @@index([userId, categoryId])
  @@check(expression: sql`"amount" > 0`, name: "budget_amount_positive")
}

model RecurringTemplate {
  id                   String              @id @onCreate(uuid(7))
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 TransactionType
  amount               BigInt
  accountId            String
  account              Account             @relation("RecurringSource", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccountId String?
  destinationAccount   Account?            @relation("RecurringDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  categoryId           String?
  category             Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  merchant             String?
  counterparty         String?
  note                 String?
  frequency            RecurringFrequency
  // Day of month for MONTHLY/YEARLY (1..31, clamped to month length).
  dayOfMonth           Int?
  // 0 = Sunday … 6 = Saturday for WEEKLY.
  dayOfWeek            Int?
  // Next scheduled run (UTC instant). Advances after each generation.
  nextRunAt            TimestamptzString
  lastRunAt            TimestamptzString?
  active               Boolean             @default(true)
  createdAt            TimestamptzString @onCreate(now())
  updatedAt            TimestamptzString @onCreate(now()) @onUpdate(now())

  @@index([userId])
  @@index([userId, active, nextRunAt])
  drafts RecurringDraft[]

  @@index([userId])
  @@index([userId, active, nextRunAt])
  @@check(expression: sql`"amount" > 0`, name: "recurring_amount_positive")
  @@check(expression: sql`("type" = 'TRANSFER') = ("destinationAccountId" IS NOT NULL)`, name: "recurring_transfer_destination_consistency")
  @@check(expression: sql`"type" <> 'TRANSFER' OR "destinationAccountId" <> "accountId"`, name: "recurring_transfer_accounts_differ")
}

// A staged occurrence of a recurring template. The worker drafts instead of
// committing, so the owner confirms or skips before money moves.
model RecurringDraft {
  id           String @id @onCreate(uuid(7))
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String
  template     RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // Scheduled instant this draft covers; unique per template for idempotency.
  runAt        TimestamptzString
  type         TransactionType
  amount       BigInt
  accountId    String
  account      Account  @relation("RecurringDraftSource", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccountId String?
  destinationAccount Account? @relation("RecurringDraftDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  merchant     String?
  counterparty String?
  note         String?
  // PENDING, CONFIRMED, SKIPPED
  status       String @default("PENDING")
  // Set when confirmed; links to the committed transaction.
  transactionId String?
  confirmedAt  TimestamptzString?
  skippedAt    TimestamptzString?
  createdAt    TimestamptzString @onCreate(now())
  updatedAt    TimestamptzString @onCreate(now()) @onUpdate(now())

  @@unique([templateId, runAt])
  @@index([userId, status, runAt])
  @@check(expression: sql`"amount" > 0`, name: "recurring_draft_amount_positive")
  @@check(expression: sql`"status" IN ('PENDING', 'CONFIRMED', 'SKIPPED')`, name: "recurring_draft_status_valid")
}

// ---------------------------------------------------------------------------
// Notifications and channels (Phase 4)
// ---------------------------------------------------------------------------

model ChannelEndpoint {
  id          String  @id @onCreate(uuid(7))
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // PUSH, NTFY, TELEGRAM, EMAIL
  kind        String
  // Push endpoint URL or channel address.
  endpoint    String
  // VAPID push keys (base64url), null for non-push channels.
  p256dh     String?
  auth        String?
  label       String?
  active      Boolean @default(true)
  failureCount Int    @default(0)
  lastUsedAt  TimestamptzString?
  createdAt   TimestamptzString @onCreate(now())
  updatedAt   TimestamptzString @onCreate(now()) @onUpdate(now())

  deliveries  NotificationDelivery[]

  @@index([userId, kind])
  @@index([userId, active])
}

model Notification {
  id         String  @id @onCreate(uuid(7))
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dedupeKey  String?
  title      String
  body       String
  severity   String  @default("INFO")
  url        String?
  readAt     TimestamptzString?
  snoozedUntil TimestamptzString?
  createdAt  TimestamptzString @onCreate(now())

  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@unique([userId, dedupeKey])
}

model NotificationDelivery {
  id               String  @id @onCreate(uuid(7))
  notificationId   String
  notification     Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channelEndpointId String?
  channelEndpoint  ChannelEndpoint? @relation(fields: [channelEndpointId], references: [id], onDelete: SetNull)
  channel          String
  status           String  @default("PENDING")
  attempts         Int     @default(0)
  lastError        String?
  deliveredAt      TimestamptzString?
  createdAt        TimestamptzString @onCreate(now())

  @@index([notificationId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Rules engine (Phase 5)
// ---------------------------------------------------------------------------

model Rule {
  id          String  @id @onCreate(uuid(7))
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Trigger definition (JSON): type, filters.
  trigger     Json
  // Condition tree (JSON): all/any/not, metric comparisons.
  condition   Json
  // Actions (JSON): notify, tag, reminder, ai comment, webhook.
  actions     Json
  // Settings (JSON): severity, cooldown, activeDays, activeHours, oneShot, snooze.
  settings    Json
  active      Boolean @default(true)
  version     Int     @default(1)
  createdAt   TimestamptzString @onCreate(now())
  updatedAt   TimestamptzString @onCreate(now()) @onUpdate(now())

  states      RuleState[]
  firings     RuleFiring[]

  @@index([userId, active])
}

model RuleState {
  id             String  @id @onCreate(uuid(7))
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId         String
  rule           Rule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  // Armed/disarmed and last condition truth for edge-triggered firing.
  state          Json
  lastEvaluatedAt TimestamptzString?
  lastFiredAt    TimestamptzString?
  createdAt      TimestamptzString @onCreate(now())
  updatedAt      TimestamptzString @onCreate(now()) @onUpdate(now())

  @@unique([userId, ruleId])
  @@index([userId])
}

model RuleFiring {
  id           String  @id @onCreate(uuid(7))
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId       String
  rule         Rule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dedupeKey    String?
  firedAt      TimestamptzString @onCreate(now())
  metricValues Json
  notificationId String?

  @@index([userId, ruleId, firedAt])
  @@unique([userId, dedupeKey])
}

// ---------------------------------------------------------------------------
// AI chat (Phase 6)
// ---------------------------------------------------------------------------

model ChatThread {
  id         String            @id @onCreate(uuid(7))
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  isFavorite Boolean           @default(false)
  modelId    String?
  createdAt  TimestamptzString @onCreate(now())
  updatedAt  TimestamptzString @onCreate(now()) @onUpdate(now())

  messages ChatMessage[]

  @@index([userId, isFavorite, updatedAt])
  @@index([userId, updatedAt])
}

model ChatMessage {
  id          String            @id @onCreate(uuid(7))
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId    String
  thread      ChatThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role        String
  content     String
  parts       Json?
  toolCalls   Json?
  toolResults Json?
  createdAt   TimestamptzString @onCreate(now())

  @@index([threadId, createdAt])
}

model AiFact {
  id        String  @id @onCreate(uuid(7))
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fact      String
  createdAt TimestamptzString @onCreate(now())

  @@index([userId])
}

model AiProviderConfig {
  id                String            @id @onCreate(uuid(7))
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AiProviderType
  name              String
  apiKey            String
  baseUrl           String?
  model             String            @default("")
  customModels      Json?
  isDefault         Boolean           @default(false)
  totalInputTokens  Int               @default(0)
  totalOutputTokens Int               @default(0)
  totalTokens       Int               @default(0)
  createdAt         TimestamptzString @onCreate(now())
  updatedAt         TimestamptzString @onCreate(now()) @onUpdate(now())

  usageLogs         AiUsageLog[]

  @@index([userId])
}

model AiUsageLog {
  id               String            @id @onCreate(uuid(7))
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfigId String
  providerConfig   AiProviderConfig  @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  threadId         String?
  modelId          String
  inputTokens      Int               @default(0)
  outputTokens     Int               @default(0)
  totalTokens      Int               @default(0)
  createdAt        TimestamptzString @onCreate(now())

  @@index([userId, createdAt])
  @@index([providerConfigId, createdAt])
}

// ---------------------------------------------------------------------------
// Infrastructure: transactional outbox and audit trail
// ---------------------------------------------------------------------------

model OutboxEvent {
  id            String       @id @onCreate(uuid(7))
  userId        String
  // Entity that changed, e.g. "Transaction".
  aggregateType String
  aggregateId   String
  // Event name, e.g. "transaction.created".
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  // Last error, for the dead-letter view.
  lastError     String?
  publishedAt   TimestamptzString?
  createdAt     TimestamptzString @onCreate(now())

  // Consumers poll the oldest pending event first.
  @@index([status, createdAt])
  @@index([userId, aggregateType, aggregateId])
}

model AuditLog {
  id         String      @id @onCreate(uuid(7))
  userId     String
  // Entity being changed, e.g. "Transaction".
  entityType String
  entityId   String
  // CREATE, UPDATE, SOFT_DELETE, RESTORE, MERGE, UNLOCK, …
  action     String
  before     Json?
  after      Json?
  // Who did it (a user id; null means the system/worker).
  actorId    String?
  createdAt  TimestamptzString @onCreate(now())

  @@index([userId, entityType, entityId])
  @@index([createdAt])
}
