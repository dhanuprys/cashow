{
  "name": "cashow",
  "version": "0.1.0",
  "private": true,
  "description": "Cashow — a self-hosted money traceability ledger (Ikuti ke mana uangmu mengalir).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --env-file=.env run --filter @cashow/web dev",
    "build": "bun run --filter @cashow/web build",
    "start": "bun --env-file=.env run --filter @cashow/web start",
    "worker": "bun --env-file=.env apps/worker/src/index.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "bun test",
    "test:ledger": "bun --env-file=.env scripts/test-ledger.ts",
    "test:chains": "bun --env-file=.env scripts/test-chains.ts",
    "test:summary": "bun --env-file=.env scripts/test-summary.ts",
    "test:rules": "bun --env-file=.env scripts/test-rules.ts",
    "smoke": "bun scripts/smoke-db.ts",
    "smoke:compat": "bun --env-file=.env scripts/smoke-compat.ts",
    "seed": "bun --env-file=.env scripts/seed-100k.ts",
    "seed:clean": "SEED_CLEAN=1 bun --env-file=.env scripts/seed-100k.ts",
    "bench": "bun --env-file=.env scripts/benchmark.ts",
    "test:e2e:auth": "bun --env-file=.env scripts/e2e-auth.ts",
    "db:emit": "bun run --filter @cashow/db contract:emit",
    "db:init": "bun run --filter @cashow/db db:init",
    "db:update": "bun run --filter @cashow/db db:update",
    "db:verify": "bun run --filter @cashow/db db:verify",
    "db:plan": "bun run --filter @cashow/db migration:plan",
    "db:migrate": "bun run --filter @cashow/db db:migrate",
    "db:status": "bun run --filter @cashow/db migration:status"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/bun": "^1.4.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "dependencies": {
    "ai": "^7.0.154",
    "web-push": "^3.6.7"
  }
}
